{
  "redirects": [
    {
      "source": "/en/docs",
      "destination": "/docs/",
      "permanent": true
    },
    {
      "source": "/en/docs/:path+",
      "destination": "/docs/:path+/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(download|themes|changelog|about)\\.html",
      "destination": "/$1/",
      "permanent": true
    },
    {
      "source": "/(deployment|reference)/(.*)",
      "destination": "/docs/$1/$2",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
