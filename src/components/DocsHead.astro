---
import { SITE_URL, WEBSITE_ID, SOFTWARE_ID, PERSON_ID, baseGraph } from '../data/site';

const { head, entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
const description = entry.data.description || 'Gridea Pro 使用文档与主题开发指南。';
const url = new URL(Astro.url.pathname, SITE_URL).href;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    ...baseGraph(),
    {
      '@type': 'TechArticle',
      '@id': `${url}#article`,
      headline: `${title} — Gridea Pro 文档`,
      description,
      url,
      inLanguage: 'zh-CN',
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@id': SOFTWARE_ID },
      author: { '@id': PERSON_ID },
      publisher: { '@id': `${SITE_URL}/#organization` },
    },
  ],
});
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
<meta name="author" content="Eliauk">
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
<script type="application/ld+json" set:html={jsonLd} />
